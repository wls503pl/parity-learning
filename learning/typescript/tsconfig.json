{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",                // ✅ Module generation method
    "moduleResolution": "NodeNext",      // ✅ Module path resolution strategy
    "experimentalDecorators": true,      // ✅ Support for decorators
    "emitDecoratorMetadata": true,       // Optional: for use with frameworks like NestJS
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["./**/*.ts"]
}
